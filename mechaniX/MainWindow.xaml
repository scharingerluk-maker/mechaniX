<Window x:Class="mechaniX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trägerreaktionen berechnen"
        Width="1000" Height="700" MinWidth="760" MinHeight="620"
        Background="#F3F6FA"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="MutedBrush" Color="#66758A"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#24344D"/>
        </Style>
        <Style x:Key="InputBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderBrush" Value="#D6DEE9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,22">
            <TextBlock Text="MECHANIK · STATIK" FontSize="12" FontWeight="Bold"
                       Foreground="#3973C6"/>
            <TextBlock Text="Auflagerkräfte am Einfeldträger" FontSize="28"
                       FontWeight="Bold" Margin="0,5,0,0"/>
            <TextBlock Text="Berechnung der Lagerreaktionen bei einer senkrechten Einzelkraft"
                       FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="22">
                <StackPanel>
                    <TextBlock Text="System eingeben" FontSize="18" FontWeight="Bold"
                               Margin="0,0,0,5"/>
                    <TextBlock Text="Alle Längen in Metern, Kräfte in Kilonewton."
                               FontSize="13" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,20"/>

                    <TextBlock Text="Stützweite l" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <DockPanel Margin="0,0,0,16">
                        <TextBlock Text="m" DockPanel.Dock="Right" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0"/>
                        <TextBox x:Name="SpanInput" Style="{StaticResource InputBoxStyle}"
                                 Text="6"/>
                    </DockPanel>

                    <TextBlock Text="Einzelkraft F (nach unten)" FontWeight="SemiBold"
                               Margin="0,0,0,6"/>
                    <DockPanel Margin="0,0,0,16">
                        <TextBlock Text="kN" DockPanel.Dock="Right" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0"/>
                        <TextBox x:Name="ForceInput" Style="{StaticResource InputBoxStyle}"
                                 Text="10"/>
                    </DockPanel>

                    <TextBlock Text="Position der Kraft x ab A" FontWeight="SemiBold"
                               Margin="0,0,0,6"/>
                    <DockPanel Margin="0,0,0,20">
                        <TextBlock Text="m" DockPanel.Dock="Right" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0"/>
                        <TextBox x:Name="PositionInput" Style="{StaticResource InputBoxStyle}"
                                 Text="2"/>
                    </DockPanel>

                    <Button Content="Auflagerkräfte berechnen" Height="46"
                            Background="#2868C7" Foreground="White" FontSize="15"
                            FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                            Click="CalculateButton_Click"/>
                    <TextBlock x:Name="ErrorText" Foreground="#B42318" FontSize="13"
                               TextWrapping="Wrap" Margin="0,12,0,0"/>

                    <Border Background="#F3F7FC" CornerRadius="8" Padding="13"
                            Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="Gleichgewicht" FontSize="13" FontWeight="Bold"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="R_A = F · (l − x) / l"
                                       FontFamily="Consolas" FontSize="13"/>
                            <TextBlock Text="R_B = F · x / l"
                                       FontFamily="Consolas" FontSize="13" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="2">
                <Border Background="White" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Systemskizze" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Festlager A · Loslager B · Einzelkraft senkrecht zum Träger"
                                   FontSize="13" Foreground="{StaticResource MutedBrush}"
                                   Margin="0,4,0,0"/>
                        <Canvas x:Name="DiagramCanvas" Height="260" Margin="0,8,0,0"
                                SizeChanged="DiagramCanvas_SizeChanged"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Auflagerreaktionen" FontSize="18" FontWeight="Bold"
                                   Margin="0,0,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#EEF5FF" CornerRadius="8"
                                    Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Festlager A" FontSize="13"
                                               Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock x:Name="ReactionAOutput" Text="—" FontSize="25"
                                               FontWeight="Bold" Foreground="#2868C7" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="#EEF5FF" CornerRadius="8"
                                    Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Loslager B" FontSize="13"
                                               Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock x:Name="ReactionBOutput" Text="—" FontSize="25"
                                               FontWeight="Bold" Foreground="#2868C7" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="EquilibriumOutput"
                                   Text="Die Reaktionen wirken nach oben und gleichen die Einzelkraft aus."
                                   FontSize="13" Foreground="{StaticResource MutedBrush}"
                                   Margin="0,12,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
