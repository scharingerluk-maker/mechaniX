<Window x:Class="mechaniX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trägerreaktionen berechnen"
        Width="1100" Height="820" MinWidth="900" MinHeight="700"
        Background="#F3F6FA"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="MutedBrush" Color="#66758A"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#24344D"/>
        </Style>
        <Style x:Key="InputBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#D6DEE9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,22">
            <TextBlock Text="MECHANIK · STATIK" FontSize="12" FontWeight="Bold"
                       Foreground="#3973C6"/>
            <TextBlock Text="Auflagerkräfte am Einfeldträger" FontSize="28"
                       FontWeight="Bold" Margin="0,5,0,0"/>
            <TextBlock Text="Bis zu fünf Einzelkräfte mit frei wählbarem Angriffspunkt und Winkel"
                       FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="System eingeben" FontSize="18" FontWeight="Bold"
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="Längen in m, Kräfte in kN. Winkel zur Trägerachse: 0° rechts, 90° oben; gegen den Uhrzeigersinn positiv."
                                   FontSize="12" Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,14"/>

                        <TextBlock Text="Stützweite l" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <DockPanel Margin="0,0,0,14">
                            <TextBlock Text="m" DockPanel.Dock="Right" VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0"/>
                            <TextBox x:Name="SpanInput" Style="{StaticResource InputBoxStyle}"
                                     Text="6"/>
                        </DockPanel>

                        <DockPanel Margin="0,0,0,8">
                            <Button Content="+ Kraft (max. 5)" DockPanel.Dock="Right" Width="112" Height="30"
                                    Background="#EEF5FF" Foreground="#2868C7"
                                    FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                                    Click="AddForceButton_Click"/>
                            <TextBlock Text="Einzelkräfte (1–5)" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </DockPanel>

                        <ScrollViewer Height="390" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ForceList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F7F9FC" CornerRadius="8"
                                                Padding="9" Margin="0,0,0,8">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,6">
                                                    <Button Content="Entfernen" DockPanel.Dock="Right"
                                                            Tag="{Binding}" Click="RemoveForceButton_Click"
                                                            Background="Transparent" Foreground="#B42318"
                                                            BorderThickness="0" Padding="4,0"
                                                            Cursor="Hand"/>
                                                    <TextBlock Text="{Binding Label}" FontSize="12"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Position x (m)" FontSize="10"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   Margin="0,0,0,3"/>
                                                        <TextBox Style="{StaticResource InputBoxStyle}"
                                                                 Text="{Binding Position, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Kraft F (kN)" FontSize="10"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   Margin="0,0,0,3"/>
                                                        <TextBox Style="{StaticResource InputBoxStyle}"
                                                                 Text="{Binding Magnitude, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="4">
                                                        <TextBlock Text="Winkel (°)" FontSize="10"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   Margin="0,0,0,3"/>
                                                        <TextBox Style="{StaticResource InputBoxStyle}"
                                                                 Text="{Binding Angle, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock x:Name="ErrorText" Foreground="#B42318" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <Button Content="Auflagerkräfte berechnen" Height="44"
                                Background="#2868C7" Foreground="White" FontSize="14"
                                FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                                Margin="0,10,0,0" Click="CalculateButton_Click"/>
                        <Border Background="#F3F7FC" CornerRadius="8" Padding="12"
                                Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Gleichgewicht" FontSize="12" FontWeight="Bold"
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="ΣFₓ = 0 · ΣFᵧ = 0 · ΣM_A = 0"
                                           FontFamily="Consolas" FontSize="12"/>
                                <TextBlock Text="Loslager B überträgt keine horizontale Kraft."
                                           FontSize="11" Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Column="2">
                <Border Background="White" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Systemskizze" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Festlager A: horizontal und vertikal · Loslager B: nur vertikal"
                                   FontSize="12" Foreground="{StaticResource MutedBrush}"
                                   Margin="0,4,0,0"/>
                        <Canvas x:Name="DiagramCanvas" Height="300" Margin="0,8,0,0"
                                SizeChanged="DiagramCanvas_SizeChanged"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Auflagerreaktionen" FontSize="18" FontWeight="Bold"
                                   Margin="0,0,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#EEF5FF" CornerRadius="8"
                                    Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Festlager A · horizontal" FontSize="11"
                                               Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock x:Name="ReactionAxOutput" Text="Aₓ = —" FontSize="20"
                                               FontWeight="Bold" Foreground="#2868C7" Margin="0,4,0,0"/>
                                    <TextBlock Text="kN" FontSize="11"
                                               Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="#EEF5FF" CornerRadius="8"
                                    Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Festlager A · vertikal" FontSize="11"
                                               Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock x:Name="ReactionAyOutput" Text="Aᵧ = —" FontSize="20"
                                               FontWeight="Bold" Foreground="#2868C7" Margin="0,4,0,0"/>
                                    <TextBlock Text="kN" FontSize="11"
                                               Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Background="#EEF5FF" CornerRadius="8"
                                    Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Loslager B · vertikal" FontSize="11"
                                               Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock x:Name="ReactionBOutput" Text="Bᵧ = —" FontSize="20"
                                               FontWeight="Bold" Foreground="#2868C7" Margin="0,4,0,0"/>
                                    <TextBlock Text="kN · horizontal = 0" FontSize="11"
                                               Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="EquilibriumOutput"
                                   Text="Positive x zeigt nach rechts, positive y nach oben."
                                   FontSize="12" Foreground="{StaticResource MutedBrush}"
                                   Margin="0,12,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
